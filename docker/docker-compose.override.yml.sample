# Encrypts backups and the data synced to a secondary, see README. Use the same
# passphrase on every server and keep a copy elsewhere: backups cannot be
# restored without it. Generate one with: openssl rand -base64 32
x-backup-passphrase: &backup-passphrase ""         # <<< INSERT PASSPHRASE

services:
  ddns:
    environment:
      DDNS_DOMAIN: d.example.net                      # <<< ADJUST DOMAIN
      DDNS_SOA_DOMAIN: ddns.example.net               # <<< ADJUST DOMAIN
      DDNS_EXPIRATION_DAYS: 10
      DDNS_PUBLIC_URL: https://ddns.example.net       # <<< ADJUST DOMAIN
      DDNS_BACKUP_PASSPHRASE: *backup-passphrase
      # "closed" leaves creating hosts to the admin panel
      DDNS_REGISTRATION: open
      DDNS_REGISTRATIONS_PER_HOUR: 5
      # With a secondary server, list every nameserver of the zone (README)
      # DDNS_NAMESERVERS: ddns.example.net,ns2.example.net
      # Optional: sign in to the admin panel with Google, see README
      # DDNS_GOOGLE_CLIENT_ID: ...
      # DDNS_GOOGLE_CLIENT_SECRET: ...
      # DDNS_ADMIN_EMAIL: you@gmail.com

  powerdns:
    ports:
      - "53:53/udp"
      - "53:53/tcp"

  backup:
    environment:
      DDNS_BACKUP_PASSPHRASE: *backup-passphrase

  redis:
    volumes:
      - "./.redis_mount:/data"

  caddy:
    restart: unless-stopped
    image: caddy:2.11
    depends_on:
      - ddns
    environment:
      DDNS_FRONTEND_HOST: ddns:8080
      DDNS_CADDY_DOMAIN: ddns.example.net             # <<< ADJUST DOMAIN
      DDNS_CADDY_TLS_EMAIL: changeme@example.net      # <<< INSERT EMAIL
    volumes:
      - "./caddy/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "./.caddy_mount:/data"
    ports:
      - "80:80"
      - "443:443"
